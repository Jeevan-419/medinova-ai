# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Port for the Node.js server to run on (Default: 5000)
PORT=5000

# MongoDB Connection String (Replace with your own Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/medinova
MONGO_URI=your_mongodb_atlas_connection_string

# Secret key for JWT Authentication (Make this a random string in production)
JWT_SECRET=super_secret_jwt_key_for_medinova_2026

# Node Environment ('development' or 'production')
NODE_ENV=development

# Gemini API Key (Optional - for AI Medical Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here
